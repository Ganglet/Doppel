
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doppel Generator Output Contract",
  "type": "object",
  "required": [
    "run_id",
    "generator_name",
    "generator_version",
    "input_dataset_id",
    "output_path",
    "output_format",
    "num_records",
    "seed"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "generator_name": {
      "type": "string",
      "enum": [
        "gaussian_copula",
        "independent_marginals",
        "ctgan",
        "tvae",
        "tabular_diffusion"
      ]
    },
    "generator_version": {
      "type": "string"
    },
    "input_dataset_id": {
      "type": "string"
    },
    "output_path": {
      "type": "string"
    },
    "output_format": {
      "type": "string",
      "enum": [
        "csv",
        "parquet"
      ]
    },
    "num_records": {
      "type": "integer",
      "minimum": 0
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "hyperparams": {
      "type": "object"
    },
    "train_rows": {
      "type": "integer",
      "minimum": 0
    },
    "train_csv_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "codec": {
      "type": "object"
    },
    "git_commit": {
      "type": "string"
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}